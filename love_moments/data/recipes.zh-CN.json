    {"id":"recipe_builtin_braised_pork","version":1,"name":"红烧肉","cuisine":"chinese","category":"家常菜","meal_slots":["lunch","dinner"],"base_servings":3,"prep_minutes":15,"cook_minutes":65,"difficulty":"medium","ingredients":[{"name":"五花肉","quantity":600,"unit":"克"},{"name":"冰糖","quantity":25,"unit":"克"},{"name":"生抽","quantity":20,"unit":"毫升"},{"name":"姜","quantity":4,"unit":"片"}],"steps":["五花肉切块后焯水并沥干。","小火融化冰糖，放入肉块翻炒上色。","加入调味料和热水，小火焖煮后大火收汁。"],"tips":["加入热水可以减少肉质骤缩。"],"allergen_tags":["大豆"]},
    {"id":"recipe_builtin_sweet_sour_ribs","version":1,"name":"糖醋排骨","cuisine":"chinese","category":"家常菜","meal_slots":["lunch","dinner"],"base_servings":3,"prep_minutes":15,"cook_minutes":45,"difficulty":"medium","ingredients":[{"name":"猪肋排","quantity":600,"unit":"克"},{"name":"米醋","quantity":30,"unit":"毫升"},{"name":"白糖","quantity":35,"unit":"克"},{"name":"生抽","quantity":15,"unit":"毫升"}],"steps":["排骨焯水后冲洗干净。","煎至表面微黄，加入糖、醋、生抽和热水。","小火焖至软烂，再开大火将酱汁收浓。"],"tips":["米醋分两次加入，酸香更有层次。"],"allergen_tags":["大豆"]},
