# 复制为 .env 后填写。真实密钥只能保存在服务端 .env 中。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 旅行一次生成五套多日方案，推理模型需要更长时间与输出空间。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8192

# 外部接口“本地硬上限”。每次真正发出网络请求前会原子扣减；缓存和 mock 不扣。
# 80% 时后台预警，100% 后直接停止该接口。0 表示完全禁止真实请求，unlimited 表示只记录、不设本地上限。
# 这些值应小于或等于你在各服务控制台看到的免费额度，并给同一密钥在别处的使用留余量。
LLM_DAILY_REQUEST_LIMIT=unlimited
AMAP_DAILY_REQUEST_LIMIT=500
GEOAPIFY_DAILY_REQUEST_LIMIT=1000
SERPAPI_MONTHLY_REQUEST_LIMIT=230
# 聚合数据的免费包常是累计次数而非每天重置，因此这里使用“累计硬上限”。
JUHE_TRAIN_TOTAL_REQUEST_LIMIT=90
ALIYUN_OCR_MONTHLY_REQUEST_LIMIT=100
OCR_HTTP_MONTHLY_REQUEST_LIMIT=100
BOOKING_DAILY_REQUEST_LIMIT=50

# 智能动态界面可单独指定模型；留空时依次复用上面的 LLM_* 配置。
UI_LLM_API_KEY=
UI_LLM_BASE_URL=
UI_LLM_MODEL=
# 智能界面最长等待 20 秒，超时后立即使用稳定规则；旅行/约会沿用上方完整超时。
UI_LLM_TIMEOUT_SECONDS=20

# 旅行对话助手默认复用 LLM_*。只有想给“问 AI”单独换模型时才填写下面四项。
# 模型只解析酒店/餐厅/方案/行程意图，真实店铺、价格和评分仍来自高德及报价接口。
TRAVEL_ASSISTANT_LLM_API_KEY=
TRAVEL_ASSISTANT_LLM_BASE_URL=
TRAVEL_ASSISTANT_LLM_MODEL=
TRAVEL_ASSISTANT_LLM_TIMEOUT_SECONDS=30

# 双人生活助理默认复用 LLM_*，只负责把一句话解析为受控意图。
# 模型不会获得聊天正文、私密瞬间、数据库 ID，也不能直接写入日历或采购清单。
# 留空时使用稳定中文规则；模型超时或返回非法 JSON 时也会自动回退规则。
LIFE_ASSISTANT_LLM_API_KEY=
LIFE_ASSISTANT_LLM_BASE_URL=
LIFE_ASSISTANT_LLM_MODEL=
LIFE_ASSISTANT_LLM_TIMEOUT_SECONDS=30

# “帮我表达”默认复用 LLM_*；留空时使用本地规则并在页面诚实标注 provider=rules。
# 每次只向模型发送本人明确选择的一条文字消息或当前输入草稿，不读取聊天前后文。
EXPRESSION_LLM_API_KEY=
EXPRESSION_LLM_BASE_URL=
EXPRESSION_LLM_MODEL=
EXPRESSION_LLM_TIMEOUT_SECONDS=30
# 0.0.0.0 允许同一局域网中的两部手机访问；只在本机使用可改为 127.0.0.1。
APP_HOST=0.0.0.0
APP_PORT=18765

# 是否创建本地演示账号和演示数据。个人实际使用必须保持 false；自动化测试会单独开启。
DEMO_MODE=false

# 简易后台管理员账号白名单；必须填写已经注册的恋屿账号，多个账号用英文逗号分隔。
# 后台地址为 /admin，仍需先正常登录；不要把伴侣账号默认设为管理员。
ADMIN_USERNAMES=

# 可分别保留 Sakura/Tailscale 候选，切换时无需删除；候选通过手机流量 HTTPS 验收后再复制到 PUBLIC_BASE_URL。
SAKURA_PUBLIC_BASE_URL=
TAILSCALE_PUBLIC_BASE_URL=
# 当前真正生效的固定 HTTPS 访问地址，用于后台判断手机安全上下文，例如 https://love.example.com。
PUBLIC_BASE_URL=

# 双人自用建议两个账号创建并绑定后改为 closed，防止公网访客注册。
# 需要更换伴侣账号时可临时改为 open，注册完成后立即关闭。
REGISTRATION_MODE=closed

# 可选的腾讯云部署目标。真实公网/内网地址只填写在本机 .env，不要提交到仓库。
TENCENT_CLOUD_DEPLOYMENT_STATUS=pending
TENCENT_CLOUD_REGION=
TENCENT_CLOUD_INSTANCE_NAME=
TENCENT_CLOUD_PUBLIC_IPV4=
TENCENT_CLOUD_PRIVATE_IPV4=
TENCENT_CLOUD_APP_PORT=52013
TENCENT_CLOUD_TEST_BASE_URL=
TENCENT_CLOUD_OS=
TENCENT_CLOUD_DOMAIN=
TENCENT_CLOUD_HTTPS_ENABLED=false

# 本机完整备份目录；相对路径以项目根目录为准。
BACKUP_ROOT=backups

# 可选：把已验证的每日备份再复制到另一块磁盘。留空表示不做第二份镜像。
BACKUP_MIRROR_ROOT=

# 守护状态和日志目录。相对路径以项目根目录为准，目录会自动设为仅当前账号可读。
MAINTENANCE_STATE_ROOT=data/maintenance
LOG_ROOT=data/logs

# macOS 本机通知与健康检查自动重启；不需要通知时可改为 false。
LOCAL_ADMIN_NOTIFICATIONS=true
WATCHDOG_AUTO_RESTART=true

# SQLite 数据库路径。默认放在项目 data 目录；自动化测试可指向临时文件，避免改动真实数据。
DATABASE_PATH=data/love_moments.db

# 允许跨域调用 API 的前端来源；多个来源用英文逗号分隔，精确到协议、主机和端口。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18765,http://localhost:18765

# 照片、语音和短视频在电脑上的保存目录。相对路径以项目根目录为准。
MEDIA_ROOT=data/media

# 媒体容量和磁盘保护，单位 MB。达到个人/情侣上限后拒绝新文件；
# 本地磁盘低于视频阈值时先暂停视频，低于通用阈值时暂停全部媒体上传。
MEDIA_USER_QUOTA_MB=5120
MEDIA_COUPLE_QUOTA_MB=10240
MEDIA_MIN_FREE_MB=2048
MEDIA_VIDEO_MIN_FREE_MB=5120

# 服务端保存图片的最长边和 JPEG/WebP 质量；浏览器还会先压缩超过 2 MB 的大图。
MEDIA_IMAGE_MAX_EDGE=4096
MEDIA_IMAGE_QUALITY=88

# 媒体短时访问票据签名密钥。留空时首次启动会在 MEDIA_ROOT 下自动生成仅本机可读的
# .media-access-key；如需迁移到另一台电脑，可设置一个至少 32 字符的随机值并妥善备份。
MEDIA_SIGNING_SECRET=

# 媒体保存方式：local=仅电脑本地，qiniu=电脑本地+七牛云双副本，supabase=Supabase Storage。
# 选择云存储但凭证不完整时会安全回退到本地，不会把密钥返回给客户端。
MEDIA_STORAGE_PROVIDER=local

# Session Cookie 是否只允许通过 HTTPS 发送。
# 本地 http://127.0.0.1 调试保持 false；正式 HTTPS 部署必须改为 true。
COOKIE_SECURE=auto

# 免费的标准 Web Push 来电提醒。无需 Firebase、Apple Developer Program 或外部 API Key；
# 第一次启动会在 MEDIA_ROOT 下自动生成并备份 VAPID 私钥。手机异地访问必须使用 HTTPS。
WEB_PUSH_ENABLED=true
# VAPID 联系标识，只会发送给浏览器推送服务，不是密钥。可改成你的 HTTPS 站点或联系邮箱。
WEB_PUSH_VAPID_SUBJECT=https://love-moments.local
# 留空时使用 MEDIA_ROOT/.web-push-vapid-private.pem；迁移时务必连同媒体备份恢复该文件。
WEB_PUSH_PRIVATE_KEY_PATH=
# 仅允许标准浏览器推送服务域名，避免订阅地址被利用访问任意服务器。
WEB_PUSH_ALLOWED_HOST_SUFFIXES=.push.apple.com,.googleapis.com,.push.services.mozilla.com,.notify.windows.com

# 高德地图 Web 服务 Key：用于国内地点搜索、地理编码、路线和天气。
# 在高德开放平台创建“Web 服务”类型 Key；仅供服务端使用，可以留空。
AMAP_WEB_KEY=

# Geoapify：用于海外地点联想、地理编码和步行/骑行/驾车/公交路线。
# 免费计划每天 3000 credits，无需绑定银行卡；这里保守限制为 1000。
# 申请：https://myprojects.geoapify.com/。密钥只允许服务端读取。
GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=20

# 是否启用 Open-Meteo：true=启用，false=关闭。基础公共接口不需要 Key。
OPEN_METEO_ENABLED=true

# Cloudflare Realtime TURN Key ID：服务端用于签发 WebRTC 短时中继凭证。
# 在 Cloudflare 控制台 Realtime → TURN 获取；不用真实语音通话时可留空。
CLOUDFLARE_TURN_KEY_ID=

# Cloudflare TURN API Token：敏感密钥，只能保存在服务端。
CLOUDFLARE_TURN_API_TOKEN=

# TURN 验收时可临时设为 true，强制 WebRTC 只使用中继候选；日常使用保持 false。
WEBRTC_FORCE_RELAY=false

# 当前语音提供方。shengwang 使用声网 RTC；webrtc 使用原生 WebRTC/STUN/TURN 回退。
RTC_PROVIDER=shengwang

# 声网项目 App ID：客户端初始化标识。可以下发，但仍建议只通过服务端配置接口提供。
SHENGWANG_APP_ID=

# 声网项目主要证书：高敏感密钥，只能保存在服务端，禁止写入前端或提交仓库。
SHENGWANG_APP_CERTIFICATE=

# 服务端签发的短期 RTC Token 有效时间，范围 300～86400 秒。
SHENGWANG_TOKEN_TTL_SECONDS=3600

# 七牛云 Kodo AccessKey/SecretKey：启用后每个新文件同时保存到本机和七牛私有空间；任一写入失败都不会显示为保存成功。
# 密钥仅供服务端使用，禁止放入前端或提交仓库。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# 填写空间概览中的“S3 空间名”，它在名称非全局唯一时可能与控制台空间名不同。
QINIU_BUCKET=love-moments

# 填写空间概览中的 S3 Region 和对应官方 HTTPS Endpoint。
# 华东-浙江 cn-east-1；华东-浙江2 cn-east-2；华北-河北 cn-north-1；华南-广东 cn-south-1。
QINIU_S3_REGION=cn-east-1
QINIU_S3_ENDPOINT=https://s3.cn-east-1.qiniucs.com

# Supabase 项目 URL，例如：https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon/public Key；使用前必须配置 RLS。不要在这里填写 service_role Key。
SUPABASE_ANON_KEY=

# Supabase Storage 的 Bucket 名称。需在 Storage 页面预先创建并设置合适的 RLS。
SUPABASE_BUCKET=love-moments

# OCR 提供方：auto 优先使用配置完整且启用的阿里云，其次使用通用 HTTP，最后回退 mock。
# 也可明确填写 aliyun、http 或 mock；选择真实提供方但配置不完整时会直接报错，不静默伪装成功。
OCR_PROVIDER=auto

# 通用 OCR HTTP 备用适配器。接口接收 image_base64、mime_type、hint_text，返回 text 或 items。
OCR_API_URL=
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=30

# 已获授权的酒店/交通报价聚合接口。不得填写网页抓取地址。
# 没有商务接口时留空，系统显示模拟报价并允许手工录入。
BOOKING_API_URL=
BOOKING_API_KEY=

# SerpApi：查询 Google Flights / Google Hotels，并为单个餐饮行程检索
# 大众点评、美团、小红书的具体公开结果。不会抓取登录后内容，也不会伪造平台评分。
# 餐饮查询一次只发出一条聚合搜索，免费额度有限，建议保留缓存。
# 密钥只放在本机 .env，不要写入前端或提交到仓库。
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
# 给免费套餐预留余量，应用达到该月软上限后会停止新的远程查询。
# 兼容旧配置名；新安装请使用文件顶部的 SERPAPI_MONTHLY_REQUEST_LIMIT。
SERPAPI_MONTHLY_LIMIT=230
# 同一查询缓存 6 小时，减少额度消耗。
SERPAPI_CACHE_TTL_SECONDS=21600

# 聚合数据火车票：国内站到站车次、票价和余票。日期只能查询未来 15 天内。
JUHE_TRAIN_ENABLED=false
JUHE_TRAIN_API_KEY=

# 阿里云 OCR 统一识别原生适配器。RAM 用户需有 ocr:RecognizeAllText 权限。
# AccessKey 仅供服务端签名使用，不会返回前端；不要提交真实值到代码仓库。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# OCR 统一识别的默认公网接入点。代码强制 HTTPS，通常无需修改。
ALIBABA_CLOUD_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
# 地域留给官方 SDK 或后续扩展；当前 RPC 直连使用上面的 Endpoint。
ALIBABA_CLOUD_OCR_REGION_ID=cn-hangzhou

# General 适合聊天截图等普通中文文字；如需高精度可改为 Advanced。
ALIBABA_CLOUD_OCR_TYPE=General
# 设为 false 可临时禁用阿里云并让 auto 选择备用提供方或 mock。
ALIBABA_CLOUD_OCR_ENABLED=true

# 中文菜谱智能生成复用大模型；unlimited 表示只统计、不设置本地上限。
RECIPE_LLM_DAILY_REQUEST_LIMIT=unlimited

# 天聚数行中文菜谱。普通会员官方额度为每天 100 次，本机默认限制为 80 次并缓存一天。
# Key 只保存在服务端；需要先在天聚数行控制台申请“菜谱查询”接口权限。
TIANAPI_RECIPE_ENABLED=false
TIANAPI_RECIPE_KEY=
TIANAPI_RECIPE_DAILY_REQUEST_LIMIT=80
TIANAPI_RECIPE_CACHE_TTL_SECONDS=86400

# TheMealDB 公共菜谱源。无需 Key；只在用户主动点击“在线找菜谱”时请求，结果会缓存一天。
# 外部英文内容会先转成受校验的中文草稿，用户确认后才保存。
THEMEALDB_ENABLED=true
THEMEALDB_DAILY_REQUEST_LIMIT=100
THEMEALDB_CACHE_TTL_SECONDS=86400

# Spoonacular 是可选补充源，需要自行申请 API Key。默认关闭，不影响菜谱、点菜和采购功能。
SPOONACULAR_ENABLED=false
SPOONACULAR_API_KEY=
SPOONACULAR_DAILY_REQUEST_LIMIT=40
SPOONACULAR_CACHE_TTL_SECONDS=3600
