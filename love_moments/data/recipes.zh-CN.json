    {"id":"recipe_builtin_french_toast","version":1,"name":"法式吐司","cuisine":"western","category":"早餐","meal_slots":["breakfast","snack"],"base_servings":2,"prep_minutes":8,"cook_minutes":10,"difficulty":"easy","ingredients":[{"name":"厚吐司","quantity":4,"unit":"片"},{"name":"鸡蛋","quantity":2,"unit":"个"},{"name":"牛奶","quantity":120,"unit":"毫升"},{"name":"黄油","quantity":15,"unit":"克"}],"steps":["鸡蛋与牛奶充分搅匀。","吐司两面快速浸入蛋奶液。","平底锅融化黄油，将吐司两面煎至金黄。"],"tips":["吐司不要浸泡过久，以免过软。"],"allergen_tags":["蛋类","乳制品","麸质"]},
    {"id":"recipe_builtin_avocado_egg_toast","version":1,"name":"牛油果鸡蛋吐司","cuisine":"western","category":"早餐","meal_slots":["breakfast","lunch"],"base_servings":2,"prep_minutes":10,"cook_minutes":8,"difficulty":"easy","ingredients":[{"name":"吐司","quantity":4,"unit":"片"},{"name":"牛油果","quantity":1,"unit":"个"},{"name":"鸡蛋","quantity":2,"unit":"个"},{"name":"柠檬","quantity":1,"unit":"个"}],"steps":["牛油果压成泥，加入少量柠檬汁和盐。","吐司烤至表面酥脆，鸡蛋按喜好煎熟。","吐司抹牛油果泥，放上煎蛋即可。"],"tips":["柠檬汁可以延缓牛油果变色。"],"allergen_tags":["蛋类","麸质"]},
    {"id":"recipe_builtin_bacon_mushroom_frittata","version":1,"name":"培根蘑菇烘蛋","cuisine":"western","category":"早餐","meal_slots":["breakfast","lunch"],"base_servings":2,"prep_minutes":12,"cook_minutes":18,"difficulty":"medium","ingredients":[{"name":"鸡蛋","quantity":4,"unit":"个"},{"name":"培根","quantity":100,"unit":"克"},{"name":"口蘑","quantity":120,"unit":"克"},{"name":"牛奶","quantity":60,"unit":"毫升"}],"steps":["培根和蘑菇切片，炒至蘑菇变软。","鸡蛋与牛奶打匀，倒入可进烤箱的锅中。","铺上培根蘑菇，小火定型后烤至中心凝固。"],"tips":["没有烤箱时可加盖全程小火焖熟。"],"allergen_tags":["蛋类","乳制品"]},
    {"id":"recipe_builtin_margherita_pizza","version":1,"name":"玛格丽特披萨","cuisine":"western","category":"烘焙主食","meal_slots":["lunch","dinner"],"base_servings":2,"prep_minutes":35,"cook_minutes":15,"difficulty":"medium","ingredients":[{"name":"披萨面团","quantity":300,"unit":"克"},{"name":"番茄酱","quantity":80,"unit":"克"},{"name":"马苏里拉芝士","quantity":150,"unit":"克"},{"name":"罗勒叶","quantity":8,"unit":"片"}],"steps":["披萨面团擀开并用叉子扎孔。","均匀抹番茄酱，铺上芝士。","高温烤至边缘金黄，出炉后放罗勒叶。"],"tips":["烤箱和烤盘要充分预热。"],"allergen_tags":["乳制品","麸质"]},
    {"id":"recipe_builtin_cheeseburger","version":1,"name":"芝士牛肉汉堡","cuisine":"western","category":"主食","meal_slots":["lunch","dinner"],"base_servings":2,"prep_minutes":18,"cook_minutes":15,"difficulty":"medium","ingredients":[{"name":"汉堡面包","quantity":2,"unit":"个"},{"name":"牛肉馅","quantity":300,"unit":"克"},{"name":"芝士片","quantity":2,"unit":"片"},{"name":"生菜","quantity":60,"unit":"克"}],"steps":["牛肉馅分成肉饼，撒盐和黑胡椒。","热锅煎熟肉饼，最后覆盖芝士片融化。","面包夹入生菜、牛肉饼和喜欢的酱料。"],"tips":["肉饼中心轻压凹槽，煎后更平整。"],"allergen_tags":["乳制品","麸质"]},
    {"id":"recipe_builtin_roasted_vegetables","version":1,"name":"香草烤蔬菜拼盘","cuisine":"western","category":"配菜","meal_slots":["lunch","dinner"],"base_servings":3,"prep_minutes":15,"cook_minutes":28,"difficulty":"easy","ingredients":[{"name":"西葫芦","quantity":200,"unit":"克"},{"name":"彩椒","quantity":2,"unit":"个"},{"name":"土豆","quantity":250,"unit":"克"},{"name":"橄榄油","quantity":25,"unit":"毫升"}],"steps":["蔬菜切成大小相近的块。","加入橄榄油、盐和香草拌匀。","平铺在烤盘上，烤至边缘焦香并翻面一次。"],"tips":["蔬菜不要堆叠，才能烤出焦香。"],"allergen_tags":[]},
    {"id":"recipe_builtin_lemon_butter_salmon","version":1,"name":"柠檬黄油三文鱼","cuisine":"western","category":"水产主菜","meal_slots":["lunch","dinner"],"base_servings":2,"prep_minutes":12,"cook_minutes":15,"difficulty":"medium","ingredients":[{"name":"三文鱼","quantity":400,"unit":"克"},{"name":"黄油","quantity":20,"unit":"克"},{"name":"柠檬","quantity":1,"unit":"个"},{"name":"大蒜","quantity":2,"unit":"瓣"}],"steps":["三文鱼擦干并撒盐和黑胡椒。","鱼皮面朝下煎至酥脆，翻面继续煎熟。","加入黄油和大蒜淋香，出锅后挤柠檬汁。"],"tips":["三文鱼中心保留少许湿润口感更好。"],"allergen_tags":["鱼类","乳制品"]},
    {"id":"recipe_builtin_tiramisu_cup","version":1,"name":"提拉米苏杯","cuisine":"western","category":"甜品","meal_slots":["snack"],"base_servings":4,"prep_minutes":30,"cook_minutes":0,"difficulty":"medium","ingredients":[{"name":"马斯卡彭芝士","quantity":250,"unit":"克"},{"name":"淡奶油","quantity":180,"unit":"毫升"},{"name":"手指饼干","quantity":120,"unit":"克"},{"name":"咖啡液","quantity":120,"unit":"毫升"}],"steps":["马斯卡彭芝士搅顺滑，淡奶油打发后混合。","手指饼干快速蘸咖啡液并铺入杯底。","交替铺入芝士糊和饼干，冷藏定型后撒可可粉。"],"tips":["饼干快速蘸取即可，避免过度吸水。"],"allergen_tags":["乳制品","蛋类","麸质"]},
    {"id":"recipe_builtin_apple_cinnamon_oats","version":1,"name":"苹果肉桂燕麦杯","cuisine":"western","category":"早餐甜品","meal_slots":["breakfast","snack"],"base_servings":2,"prep_minutes":8,"cook_minutes":12,"difficulty":"easy","ingredients":[{"name":"燕麦片","quantity":100,"unit":"克"},{"name":"苹果","quantity":1,"unit":"个"},{"name":"牛奶","quantity":300,"unit":"毫升"},{"name":"肉桂粉","unit":"少许"}],"steps":["苹果去核切小丁。","燕麦和牛奶小火煮至浓稠，加入苹果丁。","撒肉桂粉搅匀，装杯后稍微放凉。"],"tips":["保留一部分苹果丁最后加入，口感更清爽。"],"allergen_tags":["乳制品","可能含麸质"]},
    {"id":"recipe_builtin_honey_garlic_pork","version":1,"name":"蜜汁蒜香猪排","cuisine":"western","category":"主菜","meal_slots":["lunch","dinner"],"base_servings":2,"prep_minutes":20,"cook_minutes":16,"difficulty":"easy","ingredients":[{"name":"猪里脊排","quantity":400,"unit":"克"},{"name":"蜂蜜","quantity":20,"unit":"克"},{"name":"大蒜","quantity":3,"unit":"瓣"},{"name":"黄油","quantity":15,"unit":"克"}],"steps":["猪排拍松并加盐、黑胡椒腌制。","热锅将猪排两面煎至熟透。","加入黄油、蒜末和蜂蜜翻匀，让酱汁包裹猪排。"],"tips":["蜂蜜最后加入，避免高温焦苦。"],"allergen_tags":["乳制品"]},
    {"id":"recipe_builtin_chicken_vegetable_salad","version":1,"name":"鸡肉蔬菜沙拉","cuisine":"western","category":"沙拉","meal_slots":["lunch","dinner"],"base_servings":2,"prep_minutes":18,"cook_minutes":12,"difficulty":"easy","ingredients":[{"name":"鸡胸肉","quantity":250,"unit":"克"},{"name":"生菜","quantity":200,"unit":"克"},{"name":"番茄","quantity":2,"unit":"个"},{"name":"橄榄油","quantity":15,"unit":"毫升"}],"steps":["鸡胸肉调味后煎熟，静置并切片。","生菜和番茄洗净切好并充分沥干。","混合蔬菜和鸡肉，淋橄榄油与柠檬汁调味。"],"tips":["鸡肉静置后再切，肉汁不易流失。"],"allergen_tags":[]},
    {"id":"recipe_builtin_beef_potato_stew","version":1,"name":"番茄土豆炖牛肉","cuisine":"western","category":"炖菜","meal_slots":["lunch","dinner"],"base_servings":4,"prep_minutes":20,"cook_minutes":80,"difficulty":"medium","ingredients":[{"name":"牛腩","quantity":700,"unit":"克"},{"name":"土豆","quantity":350,"unit":"克"},{"name":"番茄","quantity":3,"unit":"个"},{"name":"洋葱","quantity":150,"unit":"克"}],"steps":["牛腩切块焯水，蔬菜切块。","炒软洋葱和番茄，加入牛肉和热水炖一小时。","加入土豆继续炖至软烂，最后调味收浓。"],"tips":["土豆后放，避免完全化在汤里。"],"allergen_tags":[]},
    {"id":"recipe_builtin_garlic_bread","version":1,"name":"蒜香黄油面包","cuisine":"western","category":"烘焙小食","meal_slots":["breakfast","snack"],"base_servings":2,"prep_minutes":8,"cook_minutes":10,"difficulty":"easy","ingredients":[{"name":"法棍面包","quantity":200,"unit":"克"},{"name":"黄油","quantity":30,"unit":"克"},{"name":"大蒜","quantity":3,"unit":"瓣"},{"name":"香葱","quantity":1,"unit":"根"}],"steps":["法棍切片，黄油软化后加入蒜末和葱花。","将蒜香黄油均匀涂在面包片上。","烤至边缘金黄酥脆，趁热食用。"],"tips":["黄油提前回温更容易涂抹。"],"allergen_tags":["乳制品","麸质"]},
    {"id":"recipe_builtin_yogurt_fruit_bowl","version":1,"name":"酸奶水果碗","cuisine":"western","category":"早餐甜品","meal_slots":["breakfast","snack"],"base_servings":2,"prep_minutes":10,"cook_minutes":0,"difficulty":"easy","ingredients":[{"name":"原味酸奶","quantity":300,"unit":"克"},{"name":"香蕉","quantity":1,"unit":"根"},{"name":"草莓","quantity":150,"unit":"克"},{"name":"燕麦片","quantity":50,"unit":"克"}],"steps":["水果清洗后切成适口小块。","酸奶分装入碗，铺上水果。","撒上燕麦片，食用前轻轻拌匀。"],"tips":["燕麦最后放，能保持酥脆。"],"allergen_tags":["乳制品","可能含麸质"]}
