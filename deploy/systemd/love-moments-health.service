[Unit]
Description=Check Love Moments and restart an unhealthy container
After=love-moments.service

[Service]
Type=oneshot
WorkingDirectory=/opt/love-moments/current
ExecStart=/bin/bash -c '/usr/bin/docker compose -f deploy/docker-compose.production.yml exec -T app python scripts/maintenance.py --task health || { /usr/bin/docker compose -f deploy/docker-compose.production.yml restart app; exit 1; }'
