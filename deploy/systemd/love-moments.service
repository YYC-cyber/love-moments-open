[Unit]
Description=Love Moments production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/love-moments/current
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.production.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.production.yml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
